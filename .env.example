# Copy to .env in the repository root. Docker Compose reads this file.
# Optionally bind to your server's LAN IP instead of every interface.
BIND_ADDRESS=0.0.0.0
ADMIN_PORT=6080
BACKEND_PORT=6100
MQTT_PORT=1883

# Required: generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=
ADMIN_EMAIL=admin@example.com
# Required: choose a strong initial admin password (under 72 UTF-8 bytes).
# Single-quote values containing $ or # to keep them literal in Compose.
ADMIN_PASSWORD=

# Only needed for browser clients calling the backend directly.
# The admin portal uses its same-origin /api/ proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ESP32 factory addresses reachable on the device network
FACTORY_BACKEND_HOST=192.168.1.100
FACTORY_MQTT_HOST=192.168.1.100
