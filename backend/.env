APP_NAME=Lily Device Platform API
ENVIRONMENT=development

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Easy local development:
DATABASE_URL=sqlite:///./lily.db

# Later PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://lily:password@localhost:5432/lily

MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

MUSIC_DIR=./data/music
MAX_MUSIC_SIZE_MB=20

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword!

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
