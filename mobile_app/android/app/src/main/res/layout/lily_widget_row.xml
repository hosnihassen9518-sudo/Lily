<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="4dp" android:minHeight="54dp">
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
  <TextView android:id="@+id/device_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#352C4A" android:maxLines="2"/>
  <TextView android:id="@+id/device_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#685879"/>
 </LinearLayout>
 <Button android:id="@+id/device_on" android:layout_width="56dp" android:layout_height="48dp" android:text="On" android:textSize="12sp" android:contentDescription="Turn device on"/>
 <Button android:id="@+id/device_off" android:layout_width="56dp" android:layout_height="48dp" android:text="Off" android:textSize="12sp" android:contentDescription="Turn device off"/>
</LinearLayout>